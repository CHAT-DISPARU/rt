
#version 450
#extension GL_GOOGLE_include_directive : require

#include "structs.glsl"

=
layout(push_constant) uniform PushConstants
{
	vec3  cam_origin;
	float _pad0;

	vec3  cam_forward;
	float _pad1;

	vec3  cam_right;
	float _pad2;

	vec3  cam_up;
	float fov;

	int   frame_count;
	int   max_depth;
	uint  seed;
	float time;

	int   w_h;
	int   w_w;
	uint  light_count;
	int   shadow_ray;

	int   ru_enabled;
	int   _pad3;
	int   _pad4;
	int   _pad5;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer MaterialBuffer     { GPUMaterial materials[]; };
layout(std430, set = 0, binding = 1) readonly buffer TriangleBuffer     { GPUTriangle triangles[]; };
layout(std430, set = 0, binding = 2) readonly buffer SphereBuffer       { GPUSphere   spheres[]; };
layout(std430, set = 0, binding = 3) readonly buffer QuadBuffer         { GPUQuad     quads[]; };
layout(std430, set = 0, binding = 4) readonly buffer PlaneBuffer        { GPUPlane    planes[]; };
layout(std430, set = 0, binding = 5) readonly buffer BVHTriangleBuffer  { GPUBVHNode  bvh_triangles[]; };
layout(std430, set = 0, binding = 6) readonly buffer BVHSphereBuffer    { GPUBVHNode  bvh_spheres[]; };
layout(std430, set = 0, binding = 7) readonly buffer BVHQuadBuffer      { GPUBVHNode  bvh_quads[]; };
layout(std430, set = 0, binding = 8) writeonly buffer OutputBuffer      { uint        out_pixels[]; };
layout(std430, set = 0, binding = 9) readonly buffer LightBuffer        { GPULight    lights[]; };
layout(std430, set = 0, binding = 10) buffer AccumBuffer                { vec4        accum_pixels[]; };

#include "common.glsl"
#include "random.glsl"
#include "intersect.glsl"
#include "bvh.glsl"
#include "materials.glsl"
#include "lighting.glsl"
#include "camera.glsl"
#include "integrator.glsl"
#include "tonemap.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= pc.w_w || pixel.y >= pc.w_h)
		return;

	uint pixelIndex = uint(pixel.y) * uint(pc.w_w) + uint(pixel.x);

	uint seed = init_seed(uvec2(pixel), uint(pc.frame_count), pc.seed);

	float inv_w = 1.0 / float(pc.w_w);
	float inv_h = 1.0 / float(pc.w_h);

	float u = (float(pixel.x) + random_float(seed)) * inv_w;
	float v = (float(pixel.y) + random_float(seed)) * inv_h;

	Ray ray = camera_get_ray(u, v, seed);
	vec3 color = trace_ray(ray, seed);

	vec4 prevAccum = (pc.frame_count == 1) ? vec4(0.0) : accum_pixels[pixelIndex];
	vec4 newAccum = prevAccum + vec4(color, 0.0);
	accum_pixels[pixelIndex] = newAccum;

	vec3 finalColor = newAccum.rgb / float(pc.frame_count);
	out_pixels[pixelIndex] = tonemap_pack(finalColor);
}
