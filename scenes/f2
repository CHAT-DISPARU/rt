# --- Configuration globale ---
Settings {
    resolution 1600 900
    samples inf
}

# --- Configuration de la caméra ---
Camera {
    position -0.1 2.3 9.4
    direction -0.08 -0.15 -0.99
    fov 50
    # Ouverture bien large pour des cercles de confusion (bokeh) visibles
    lens_radius 0.30
    # Distance euclidienne PARFAITE jusqu'au centre du Dragon 2
    focus_dist 4.59
}

# --- Matériaux ---
Material "mur_blanc" {
    color 0.7 0.7 0.7
}

Material "plafond_light" {
    type emissive
    color 12.0 12.0 12.0
}

Material "metal_f16" {
    type metal
    color 0.85 0.70 0.30
    fuzz 0.02
}

Material "verre_cockpit" {
    type glass
    color 0.95 0.98 1.0
    ni 1.5
    fuzz 0.0
}

Material "rouge_mat" {
    color 0.75 0.05 0.05
}

# --- DÉCORS ---
Quad {
    position 0 0 0
    normal 0 1 0
    width 40
    height 40
    material mur_blanc
}

Quad {
    position 0 5 0
    normal 0 -1 0
    width 40
    height 40
    material mur_blanc
}

Quad {
    position 0 5 -6
    normal 0 0 1
    width 40
    height 20
    material mur_blanc
}

Quad {
    position -7 5 0
    normal 1 0 0
    width 40
    height 20
    material mur_blanc
}

Quad {
    position 7 5 0
    normal -1 0 0
    width 40
    height 20
    material mur_blanc
}

Quad {
    position 0 4.9 0
    normal 0 -1 0
    width 4
    height 4
    material plafond_light
}

# --- DRAGONS (Le Couloir de Profondeur recadré) ---

# Dragon 1 : VERRE (1er plan très flou, recentré pour être bien visible)
Mesh {
    path scenes/Dragon.obj
    scale 0.02
    position -1.3 1.0 6.6
    normal 0 0 -1
    roll 180
    material verre_cockpit
}

# Dragon 2 : METAL (Focus parfait, distance caméra = 4.53m)
Mesh {
    path scenes/Dragon.obj
    scale 0.02
    position 0.0 1.0 5.0
    normal 0 0 -1
    roll 180
    material metal_f16
}

# Dragon 3 : ROUGE (Arrière-plan flou, recentré en symétrie)
Mesh {
    path scenes/Dragon.obj
    scale 0.02
    position 1.3 1.0 3.4
    normal 0 0 -1
    roll 180
    material rouge_mat
}