Settings {
	resolution 1280 720
	samples inf
}

Camera {
	position 0 3 12
	direction 0 -0.15 -1
	fov 60
}

Environment {
	path sky.hdr
	intensity 1.0
	rotation 0
}

# --- MATERIAUX ---

Material "sol_mat" {
	color 0.8 0.8 0.8
}

Material "mur_incline_mat" {
	color 0.2 0.2 0.25
}

Material "verre_pur" {
	type dielectric
	ior 1.52
	color 1.0 1.0 1.0
	fuzz 0.0
}

Material "or_poli" {
	type metal
	color 1.0 0.78 0.34
	fuzz 0.02
}

Material "neon_chaud" {
	type emissive
	color 20.0 12.0 4.0
}

Material "rouge_vif" {
	color 0.9 0.1 0.1
}

Material "dragon_mat" {
	type metal
	color 0.1 0.6 0.8
	fuzz 0.15
}

# --- GEOMETRIE ---

# Le sol infini
Plane {
	position 0 0 0
	normal 0 1 0
	material sol_mat
}

# Le mur incliné à gauche pour tester le "roll" !
Quad {
	position -6 4 -3
	normal 1 0 0
	width 10
	height 10
	roll 45
	material mur_incline_mat
}

# La source de lumière principale (flottante en haut à droite)
Sphere {
	position 4 7 0
	radius 1.5
	normal 0 1 0
	material neon_chaud
}

# Boule de verre au premier plan à gauche
Sphere {
	position -2.5 1.5 2
	radius 1.5
	normal 0 1 0
	material verre_pur
}

# Boule d'or au premier plan à droite
Sphere {
	position 2.5 1.5 3
	radius 1.5
	normal 0 1 0
	material or_poli
}

# Un simple triangle posé au sol devant
Triangle {
	v0 -1 0.1 5
	v1  1 0.1 5
	v2  0 1.5 4.5
	material rouge_vif
}

# Le Dragon au centre de la scène
Mesh {
	path scenes/Dragon.obj
	scale 0.04
	position 0 3.3 -2
	normal 0 0 1
	roll 180
	material dragon_mat
}

# Et pour couronner le tout : la lentille gravitationnelle en arrière-plan !
Blackhole {
	position 0 6 -15
	radius 4.0
}